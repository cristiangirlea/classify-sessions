{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "models.schema.json",
  "title": "ModelsResponse",
  "description": "GET /api/models, also embedded in SummaryResponse as model_choice. Descriptive, not causal. Session ids only, never prompt text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["models", "categories", "model_totals", "excluded_sessions", "advice", "definitions", "pricing_source", "pricing_date"],
  "properties": {
    "models": { "type": "array", "items": { "type": "string" }, "description": "Canonical model families present, sorted." },
    "categories": { "type": "array", "items": { "$ref": "#/definitions/ModelCategory" } },
    "model_totals": { "type": "array", "items": { "$ref": "#/definitions/ModelCell" }, "description": "One cell per model, category \"all\"." },
    "excluded_sessions": { "type": "array", "items": { "type": "string" }, "description": "Sessions with no assistant record." },
    "advice": { "$ref": "#/definitions/ModelAdvice" },
    "definitions": { "$ref": "#/definitions/ModelDefinitions" },
    "pricing_source": { "type": "string" },
    "pricing_date": { "type": "string", "format": "date" }
  },
  "definitions": {
    "ModelCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "comparable", "supported", "reason", "cells"],
      "properties": {
        "category": { "type": "string" },
        "comparable": { "type": "boolean", "description": "Non-unknown category where at least two models have a session." },
        "supported": { "type": "boolean", "description": "Comparable and at least three sessions per model." },
        "reason": { "type": "string" },
        "cells": { "type": "array", "items": { "$ref": "#/definitions/ModelCell" } }
      }
    },
    "ModelCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "category", "sessions", "mixed_model_sessions", "long_context_sessions", "complete_cost_sessions",
        "mean_known_usd", "median_known_usd", "total_known_usd", "user_messages", "correction_messages",
        "correction_rate", "corrected_sessions", "tool_results_known", "tool_failures", "tool_failure_rate",
        "unknown_outcome_results", "session_ids"
      ],
      "properties": {
        "model": { "type": "string" },
        "category": { "type": "string" },
        "sessions": { "type": "integer", "minimum": 0 },
        "mixed_model_sessions": { "type": "integer", "minimum": 0 },
        "long_context_sessions": { "type": "integer", "minimum": 0 },
        "complete_cost_sessions": { "type": "integer", "minimum": 0 },
        "mean_known_usd": { "type": "number", "minimum": 0 },
        "median_known_usd": { "type": "number", "minimum": 0 },
        "total_known_usd": { "type": "number", "minimum": 0 },
        "user_messages": { "type": "integer", "minimum": 0 },
        "correction_messages": { "type": "integer", "minimum": 0 },
        "correction_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "corrected_sessions": { "type": "integer", "minimum": 0 },
        "tool_results_known": { "type": "integer", "minimum": 0 },
        "tool_failures": { "type": "integer", "minimum": 0 },
        "tool_failure_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "unknown_outcome_results": { "type": "integer", "minimum": 0 },
        "session_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ModelAdvice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expensive_model", "comparator_model", "shared_categories", "cost_ratio", "verdict", "statement", "caveats"],
      "properties": {
        "expensive_model": { "type": ["string", "null"] },
        "comparator_model": { "type": ["string", "null"] },
        "shared_categories": { "type": "array", "items": { "type": "string" } },
        "cost_ratio": { "type": ["number", "null"] },
        "verdict": {
          "type": "string",
          "enum": ["insufficient_evidence", "no_premium_benefit_observed", "fewer_corrections_at_premium", "no_comparison_possible"]
        },
        "statement": { "type": "string" },
        "caveats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ModelDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_model", "comparable_category", "supported_category", "cost_per_session", "correction_message", "correction_rate", "tool_failure_rate"],
      "properties": {
        "dominant_model": { "type": "string" },
        "comparable_category": { "type": "string" },
        "supported_category": { "type": "string" },
        "cost_per_session": { "type": "string" },
        "correction_message": { "type": "string" },
        "correction_rate": { "type": "string" },
        "tool_failure_rate": { "type": "string" }
      }
    }
  }
}
